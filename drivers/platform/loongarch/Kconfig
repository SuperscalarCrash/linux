#
# LoongArch Platform Specific Drivers
#

menuconfig LOONGARCH_PLATFORM_DEVICES
	bool "LoongArch Platform Specific Device Drivers"
	default y
	depends on LOONGARCH
	help
	  Say Y here to get to see options for device drivers of various
	  LoongArch platforms, including vendor-specific laptop/desktop
	  extension and hardware monitor drivers. This option itself does
	  not add any kernel code.

	  If you say N, all options in this submenu will be skipped and disabled.

if LOONGARCH_PLATFORM_DEVICES

config LOONGSON_LAPTOP
	tristate "Generic Loongson-3 Laptop Driver"
	depends on ACPI_EC
	depends on BACKLIGHT_CLASS_DEVICE
	depends on INPUT
	depends on MACH_LOONGSON64
	select ACPI_VIDEO
	select INPUT_SPARSEKMAP
	default y
	help
	  ACPI-based Loongson-3 family laptops generic driver.

config CHIPLAB_CONFREG
	tristate "Loongson Chiplab CONFREG peripherals"
	depends on OF && MACH_LOONGSON32
	depends on GPIOLIB
	depends on LEDS_CLASS
	help
	  Support the board control registers in the Loongson Chiplab FPGA
	  system.  The driver exposes the 16 monochrome LEDs and the red and
	  green channels of both bicolor LEDs through the LED class, and the
	  eight slide switches as an input-only GPIO controller.  It also
	  provides sysfs attributes for whole-register LED control, the
	  eight-digit hexadecimal seven-segment display, and switch sampling.

endif # LOONGARCH_PLATFORM_DEVICES
